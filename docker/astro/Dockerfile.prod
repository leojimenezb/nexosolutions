# Simple production Dockerfile - build static files and serve them
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy project files
COPY . .

# Build the project (environment variables will be passed from docker-compose)
RUN npm run build

# Copy .htaccess to dist
RUN cp .htaccess dist/ || echo "No .htaccess file found"

EXPOSE 4321

# Serve the built files using astro preview with host exposure
CMD ["npm", "run", "preview"]