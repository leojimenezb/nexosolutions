---
const companyInfo = {
  name: import.meta.env.PUBLIC_COMPANY_NAME || 'NEXO Soluciones',
  tagline: import.meta.env.PUBLIC_SITE_TAGLINE || 'Tecnología que impulsa tu negocio',
  email: import.meta.env.PUBLIC_CONTACT_EMAIL || 'info@nexosoluciones.com',
  phone: `+${import.meta.env.PUBLIC_CONTACT_PHONE || '1234567890'}`,
  whatsapp: import.meta.env.PUBLIC_WHATSAPP_NUMBER || '1234567890',
  address: import.meta.env.PUBLIC_COMPANY_ADDRESS || 'Ciudad de México, México'
};

const socialLinks = [
  { name: 'Facebook', icon: '📘', url: import.meta.env.PUBLIC_FACEBOOK_URL || '#' },
  { name: 'Instagram', icon: '📷', url: import.meta.env.PUBLIC_INSTAGRAM_URL || '#' },
  { name: 'LinkedIn', icon: '💼', url: import.meta.env.PUBLIC_LINKEDIN_URL || '#' },
  { name: 'Twitter', icon: '🐦', url: import.meta.env.PUBLIC_TWITTER_URL || '#' }
];

const quickLinks = [
  { name: 'Inicio', href: '#inicio' },
  { name: 'Beneficios', href: '#beneficios' },
  { name: 'Servicios', href: '#servicios' },
  { name: 'Proceso', href: '#proceso' },
  { name: 'Contacto', href: '#contacto' }
];

const services = [
  { name: 'Desarrollo web', href: '#servicios' },
  { name: 'Automatización', href: '#servicios' },
  { name: 'Soporte técnico', href: '#servicios' },
  { name: 'Consultoría TI', href: '#servicios' }
];
---

<footer class="bg-[#0F1B3D] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Company Info -->
      <div class="space-y-6">
        <div class="flex items-center space-x-2">
          <div class="w-10 h-10 bg-[#5AA832] rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl">N</span>
          </div>
          <div>
            <span class="text-xl font-bold">NEXO</span>
            <span class="text-xl font-medium text-[#5AA832]">Soluciones</span>
          </div>
        </div>
        <p class="text-slate-300 leading-relaxed">
          {companyInfo.tagline}
        </p>
        <div class="space-y-3">
          <a
            href={`mailto:${companyInfo.email}`}
            class="flex items-center text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5 mr-3 text-[#5AA832]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {companyInfo.email}
          </a>
          <a
            href={`tel:${companyInfo.phone}`}
            class="flex items-center text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5 mr-3 text-[#5AA832]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {companyInfo.phone}
          </a>
          <a
            href={`https://wa.me/${companyInfo.whatsapp.replace(/\D/g, '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5 mr-3 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-[#5AA832]">Enlaces rápidos</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-300 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-[#5AA832]">Servicios</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a
                href={service.href}
                class="text-slate-300 hover:text-white transition-colors"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social Media -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-[#5AA832]">Síguenos</h3>
        <div class="flex space-x-4">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 bg-white/10 hover:bg-[#5AA832] rounded-lg flex items-center justify-center transition-colors duration-200"
              aria-label={social.name}
            >
              <span class="text-xl">{social.icon}</span>
            </a>
          ))}
        </div>
        <p class="mt-6 text-slate-400 text-sm">
          {companyInfo.address}
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-slate-400 text-sm">
          © {new Date().getFullYear()} {companyInfo.name}. Todos los derechos reservados.
        </p>
        <div class="flex space-x-6 text-sm">
          <a href="#" class="text-slate-400 hover:text-white transition-colors">
            Política de privacidad
          </a>
          <a href="#" class="text-slate-400 hover:text-white transition-colors">
            Términos de servicio
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>