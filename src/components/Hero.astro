---
const floatingMetrics = [
  { value: '+150', label: 'Clientes satisfechos', icon: '👥' },
  { value: '98%', label: 'Proyectos exitosos', icon: '✓' },
  { value: '24/7', label: 'Soporte técnico', icon: '🔧' },
];
---

<section id="inicio" class="min-h-screen flex items-center pt-16 bg-gradient-to-br from-white via-slate-50 to-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div class="space-y-8">
        <div class="inline-flex items-center px-4 py-2 bg-[#5AA832]/10 rounded-full">
          <span class="text-[#5AA832] font-medium text-sm">Tecnología que impulsa tu negocio</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[#0F1B3D] leading-tight">
          Nos encargamos de la tecnología.
          <span class="text-[#5AA832]">Tú enfócate en hacer crecer tu negocio.</span>
        </h1>

        <p class="text-lg text-slate-600 leading-relaxed max-w-xl">
          Ayudamos a emprendedores y pequeñas empresas mediante soluciones tecnológicas, desarrollo web, automatización de procesos, soporte tecnológico y consultoría TI.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-[#5AA832] hover:bg-[#3E7B21] text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
          >
            Solicitar Asesoría
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="https://wa.me/1234567890"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-slate-50 text-[#0F1B3D] font-semibold rounded-xl border-2 border-slate-200 hover:border-[#5AA832] transition-all duration-200"
          >
            <svg class="w-5 h-5 mr-2 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Contactar por WhatsApp
          </a>
        </div>
      </div>

      <!-- Right Content - Hero Image with Floating Elements -->
      <div class="relative">
        <!-- Main Hero Illustration -->
        <div class="relative bg-gradient-to-br from-[#0F1B3D] to-[#1A4AE8] rounded-3xl p-8 shadow-2xl">
          <!-- Laptop with Dashboard -->
          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="flex items-center space-x-2 mb-4">
              <div class="w-3 h-3 bg-red-400 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-400 rounded-full"></div>
              <div class="w-3 h-3 bg-green-400 rounded-full"></div>
            </div>
            <!-- Dashboard Preview -->
            <div class="grid grid-cols-3 gap-4">
              <div class="bg-slate-100 rounded-lg p-4">
                <div class="w-8 h-8 bg-[#5AA832] rounded-lg mb-2"></div>
                <div class="h-2 bg-slate-300 rounded mb-1"></div>
                <div class="h-2 bg-slate-200 rounded w-3/4"></div>
              </div>
              <div class="bg-slate-100 rounded-lg p-4">
                <div class="w-8 h-8 bg-[#1A4AE8] rounded-lg mb-2"></div>
                <div class="h-2 bg-slate-300 rounded mb-1"></div>
                <div class="h-2 bg-slate-200 rounded w-3/4"></div>
              </div>
              <div class="bg-slate-100 rounded-lg p-4">
                <div class="w-8 h-8 bg-[#0F1B3D] rounded-lg mb-2"></div>
                <div class="h-2 bg-slate-300 rounded mb-1"></div>
                <div class="h-2 bg-slate-200 rounded w-3/4"></div>
              </div>
            </div>
            <!-- Chart -->
            <div class="mt-4 bg-slate-50 rounded-lg p-4">
              <div class="flex items-end space-x-2 h-20">
                <div class="w-1/4 bg-[#5AA832] rounded-t h-12"></div>
                <div class="w-1/4 bg-[#1A4AE8] rounded-t h-16"></div>
                <div class="w-1/4 bg-[#0F1B3D] rounded-t h-10"></div>
                <div class="w-1/4 bg-[#5AA832] rounded-t h-20"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Metrics -->
        {floatingMetrics.map((metric, index) => (
          <div
            class={`absolute bg-white rounded-xl shadow-lg p-4 flex items-center space-x-3 animate-float-${index + 1}`}
            style={{
              top: index === 0 ? '10%' : index === 1 ? '50%' : '80%',
              right: index === 0 ? '-20px' : index === 1 ? '-30px' : '-10px',
              animationDelay: `${index * 0.5}s`
            }}
          >
            <span class="text-2xl">{metric.icon}</span>
            <div>
              <div class="text-xl font-bold text-[#0F1B3D]">{metric.value}</div>
              <div class="text-sm text-slate-600">{metric.label}</div>
            </div>
          </div>
        ))}

        <!-- Decorative Elements -->
        <div class="absolute -top-4 -right-4 w-20 h-20 bg-[#5AA832]/20 rounded-full blur-xl"></div>
        <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-[#1A4AE8]/20 rounded-full blur-xl"></div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float-1 {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  @keyframes float-2 {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(10px); }
  }
  @keyframes float-3 {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .animate-float-1 { animation: float-1 3s ease-in-out infinite; }
  .animate-float-2 { animation: float-2 4s ease-in-out infinite; }
  .animate-float-3 { animation: float-3 3.5s ease-in-out infinite; }
</style>